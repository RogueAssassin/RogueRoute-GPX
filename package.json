{
  "name": "rogueroute-gpx",
  "version": "13.0.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": "26.8.1",
    "pnpm": "11.24.0"
  },
  "scripts": {
    "dev": "pnpm --filter @rogueroute-gpx/web dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @rogueroute-gpx/web start",
    "console": "pnpm --filter @rogueroute-gpx/console start",
    "version:check": "bash scripts/version.sh check",
    "version:set": "bash scripts/version.sh set",
    "typecheck": "pnpm --filter @rogueroute-gpx/core build && pnpm -r typecheck",
    "test": "pnpm -r --if-present test && node --test apps/gpx-web/supervisor/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^6.0.3"
  }
}
