ROGUEROUTE_VERSION=13.0.0
ROGUEROUTE_IMAGE=ghcr.io/rogueassassin/rogueroute-gpx
ROGUEROUTE_TAG=13.0.0
# stable pulls the VERSION tag; testing pulls VERSION-testing (built from the testing branch).
ROGUEROUTE_CHANNEL=stable
# auto picks a running engine: Podman first, or Docker first when run as root.
ROGUEROUTE_RUNTIME=auto
HOST_PORT=9080
HOST_BIND=0.0.0.0
# Container user. install.sh sets these to your account.
PUID=1000
PGID=1000
MEDIA_NETWORK=media-net

# Map data (Geofabrik extracts and prepared OSRM graphs). Mounted at /data in the container.
OSRM_DATA_DIR=/mnt/h/osrm
# Region loaded on first start. Afterwards the last served region is remembered in
# OSRM_DATA_DIR/.rogueroute-gpx/state.json.
OSRM_ACTIVE_REGION=australia
OSRM_PROFILE=foot
OSRM_SNAP_RADIUS_METERS=250
OSRM_SNAP_MAX_RADIUS_METERS=5000
OSRM_MAX_PARALLEL_LEGS=6
OSRM_SWITCH_COOLDOWN_SECONDS=60
ROGUEROUTE_STARTUP_TIMEOUT_SECONDS=600

# Set to a long random value to enable map downloads and preparation from the website.
ADMIN_TOKEN=

GPX_MAX_TRACK_POINTS=1000
GPX_SIMPLIFY_TOLERANCE_METERS=2.5
ROUTE_CACHE_LIMIT=100
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
