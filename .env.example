# ==============================================================================
# rogueroute-gpx environment configuration
# ==============================================================================
#
# Deployment directory:
#
#   /opt/media-server/rogueroute-gpx
#
# ./install.sh creates ".env" from this file. ./rogueroute-gpx update keeps ".env" in the
# same layout as this file: your values are kept, settings that no longer do anything are
# removed, and the previous file is saved as .env.backup-<time>.
#
# IMPORTANT:
# - Changes take effect after: ./rogueroute-gpx restart
# - Never commit or publish a populated .env (it can hold ADMIN_TOKEN).
# - Everything runs in one container; no Docker/Podman socket access is needed.
# ==============================================================================


# ------------------------------------------------------------------------------
# Release channel
# ------------------------------------------------------------------------------

# Which builds this server runs. Switch with one command; it changes the Git branch, this
# value and the image tag together, then updates:
#
#   ./rogueroute-gpx update stable     main branch, image X.Y.Z          (recommended)
#   ./rogueroute-gpx update testing    testing branch, image X.Y.Z-testing
#
# Stable production channel:
ROGUEROUTE_CHANNEL=stable

# Testing channel alternative (use "./rogueroute-gpx update testing" rather than editing):
# ROGUEROUTE_CHANNEL=testing

# Image repository. Leave unset for the official image; set it only to run your own build.
# ROGUEROUTE_IMAGE=ghcr.io/rogueassassin/rogueroute-gpx


# ------------------------------------------------------------------------------
# Container and host
# ------------------------------------------------------------------------------

# Container engine used by ./rogueroute-gpx on the HOST.
# Supported values: auto, podman, docker (auto picks a running engine and saves it here).
ROGUEROUTE_RUNTIME=auto

# Host address and port for the website. Use 127.0.0.1 when a reverse proxy on the same
# host is the only client; 0.0.0.0 keeps the port reachable from the LAN.
HOST_BIND=0.0.0.0
HOST_PORT=9080

# Container user (Docker). install.sh sets these to your account so map files stay yours.
# Rootless Podman ignores them and runs as your account through its user namespace.
PUID=1000
PGID=1000

# Existing network shared with Rogue Dashboard and other media services.
MEDIA_NETWORK=media-net


# ------------------------------------------------------------------------------
# Maps
# ------------------------------------------------------------------------------

# Host folder for Geofabrik extracts and prepared OSRM graphs. Mounted at /data.
OSRM_DATA_DIR=/mnt/h/osrm

# Region served on the very first start. Afterwards the last served region is remembered in
# OSRM_DATA_DIR/.rogueroute-gpx/state.json. See: ./rogueroute-gpx osm list
OSRM_ACTIVE_REGION=australia

# Routing profile used to prepare maps and route.
# Supported values: foot, bike, car (re-prepare regions after changing it).
OSRM_PROFILE=foot

# Queue regions that are downloaded but not prepared whenever the container starts.
# Failed regions are not retried until you run: ./rogueroute-gpx osm retry
ROGUEROUTE_AUTO_PREPARE=true

# CPU priority of map preparation, 0 (normal) to 19 (gentlest). Higher keeps the website and
# routing more responsive while a region builds.
ROGUEROUTE_PREPARE_NICE=10

# Cores used by map preparation. Empty uses every core.
ROGUEROUTE_PREPARE_THREADS=


# ------------------------------------------------------------------------------
# Routing
# ------------------------------------------------------------------------------

# Waypoint snapping: start at the first radius and widen up to the maximum (metres) when a
# waypoint is not next to a routable road or path.
OSRM_SNAP_RADIUS_METERS=250
OSRM_SNAP_MAX_RADIUS_METERS=5000

# Route legs requested from OSRM at the same time.
OSRM_MAX_PARALLEL_LEGS=6

# Minimum seconds between automatic region switches triggered by visitors' routes.
# The CLI and administrators skip it.
OSRM_SWITCH_COOLDOWN_SECONDS=60

# Longest wait for OSRM to load a region's graph, in seconds. Raise it for continent graphs.
ROGUEROUTE_STARTUP_TIMEOUT_SECONDS=600


# ------------------------------------------------------------------------------
# Website and GPX output
# ------------------------------------------------------------------------------

# Long random value that unlocks Map administration on /maps (queue, retry, cancel, log).
# Empty keeps map management to the CLI. Generate one with: openssl rand -hex 32
ADMIN_TOKEN=

# Point budget for the Automatic GPX detail mode.
GPX_MAX_TRACK_POINTS=1000

# Starting simplification tolerance in metres for Automatic and Compact GPX detail.
GPX_SIMPLIFY_TOLERANCE_METERS=2.5

# Generated routes kept in memory so repeat requests return instantly.
ROUTE_CACHE_LIMIT=100


# ------------------------------------------------------------------------------
# Managed by ./rogueroute-gpx (do not edit)
# ------------------------------------------------------------------------------

# Release from the checkout's VERSION file and the image tag for the channel above.
ROGUEROUTE_VERSION=13.2.0
ROGUEROUTE_TAG=13.2.0
